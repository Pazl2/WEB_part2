# Переменные для docker-compose. Скопируйте в .env:  cp .env.example .env
# Секрет подписи JWT (минимум 32 символа, не из примеров). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Адреса, с которых открывают фронтенд (CORS и Socket.IO), через запятую
CLIENT_ORIGIN=http://localhost,http://127.0.0.1

# PostgreSQL (пользователи)
POSTGRES_USER=eurotruck
POSTGRES_PASSWORD=
POSTGRES_DB=euroTruck_db

# MongoDB (посты, чат). Пароль без спецсимволов (он подставляется в URI)
MONGO_USER=eurotruck
MONGO_PASSWORD=
MONGO_DB=euroTruck
