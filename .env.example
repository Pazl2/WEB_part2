# Секрет подписи JWT. ОБЯЗАТЕЛЕН: сервер не запустится с пустым, коротким (меньше 32 символов)
# или скопированным из примеров значением. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Срок жизни токена: 15m, 1h, 12h (максимум 24h). Токен нельзя отозвать до истечения, держите срок коротким
JWT_EXPIRES_IN=1h

# Адрес клиента, которому разрешён доступ к API (CORS). Можно несколько через запятую.
# В разработке по умолчанию http://localhost:5173; в production обязателен
CLIENT_ORIGIN=http://localhost:5173
# Если сервер стоит за reverse proxy — число прокси (обычно 1), иначе rate limit считает все запросы с одного IP
# TRUST_PROXY=1

# MongoDB — посты (Atlas или локальная установка)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/euroTruck?retryWrites=true&w=majority
# MONGO_URI=mongodb://127.0.0.1:27017/euroTruck

# PostgreSQL — пользователи
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_NAME=euroTruck_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

PORT=3000
RESPONSE_DELAY_MS=0
